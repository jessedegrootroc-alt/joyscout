# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leadlens"

# ── Auth (required) ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Business discovery ─────────────────────────────────────────────────────────
# Google Places API (New). Without this key LeadLens falls back to OpenStreetMap
# (Overpass) which has no ratings/reviews. Enable "Places API (New)" + "Geocoding API".
GOOGLE_PLACES_API_KEY=""

# ── Performance (optional but recommended) ─────────────────────────────────────
# PageSpeed Insights works without a key but with a very low quota.
PAGESPEED_API_KEY=""

# ── AI analysis + outreach (one of the two) ────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides
# AI_MODEL="claude-sonnet-5"
# AI_PROVIDER="anthropic"   # or "openai"

# ── Worker tuning (optional) ───────────────────────────────────────────────────
# ANALYZE_CONCURRENCY=3
# STORAGE_DIR="./storage"
