# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/joyscrape"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Business discovery ─────────────────────────────────────────────────────────
# Google Places API (New). Without this key Joyscrape falls back to OpenStreetMap
# (Overpass) which has no ratings/reviews. Enable "Places API (New)" + "Geocoding API".
GOOGLE_PLACES_API_KEY=""

# ── Performance (optional but recommended) ─────────────────────────────────────
# PageSpeed Insights works without a key but with a very low quota.
PAGESPEED_API_KEY=""

# ── AI analysis + outreach (one of the two) ────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides
# AI_MODEL="claude-sonnet-5"
# AI_PROVIDER="anthropic"   # or "openai"

# ── Follow-up reminder emails (optional) ───────────────────────────────────────
# Either Resend (simplest) or any SMTP server. Set the recipient in Settings.
RESEND_API_KEY=""
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
MAIL_FROM="Joyscrape <reminders@yourdomain.nl>"
# MAIL_TRANSPORT="log"   # dev: print reminder mails to the worker log instead of sending

# ── Worker tuning (optional) ───────────────────────────────────────────────────
# ANALYZE_CONCURRENCY=3
# STORAGE_DIR="./storage"
